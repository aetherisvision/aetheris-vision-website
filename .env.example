# ===================================================================
# website/.env.example
# Personal/marketing website — template for website/.env.local
# Copy to .env.local and fill in real values before running
# Safe to commit — contains no real credentials
# ===================================================================

# ── Database ────────────────────────────────────────────────────────
# Neon PostgreSQL — get from Neon dashboard (project → Connection Details)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# AUTH_SECRET is also accepted as an alternative variable name.
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Stripe (payment processing) ─────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Get from https://dashboard.stripe.com/webhooks after creating a webhook endpoint
# Endpoint URL: https://aetherisvision.com/api/webhooks/stripe
# Events: invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Anthropic (SOW / AI generation) ─────────────────────────────────
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# ── Email (Resend) ───────────────────────────────────────────────────
# Get from https://resend.com/api-keys
# Used for magic-link sign-in, invoices, intake, AND the contact form.
# When unset, the contact form returns 503 and shows its "unavailable" notice.
RESEND_API_KEY="re_..."

# ── Public form verification and abuse protection ───────────────
# Generate a private value containing at least 32 bytes, for example:
# openssl rand -base64 32
CONTACT_VERIFICATION_SECRET="your-at-least-32-byte-verification-secret"
# Cloudflare Turnstile keys for a widget configured for aetherisvision.com.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# ── Admin portal ─────────────────────────────────────────────────────
# Passphrase for /admin login. The server derives the signed session cookie.
ADMIN_PASSPHRASE="your-admin-passphrase"

# Public preview gate (optional). When set, public routes require a signed
# preview session.
PREVIEW_PASSWORD="your-preview-password"

# ── Scheduled Gmail receipt ingestion ───────────────────────────────
# Vercel uses CRON_SECRET to authenticate /api/cron/receipts.
CRON_SECRET="your-random-cron-secret"
GMAIL_CLIENT_ID="your-google-oauth-client-id"
GMAIL_CLIENT_SECRET="your-google-oauth-client-secret"
# Optional; defaults to 30 and is constrained to 1–90 days.
GMAIL_RECEIPT_LOOKBACK_DAYS="30"

# ── DocuSeal (contracts and signatures) ─────────────────────────────
# Required in production for contract delivery and signed-document webhooks.
DOCUSEAL_API_KEY="your-docuseal-api-key"
DOCUSEAL_WEBHOOK_SECRET="your-docuseal-webhook-secret"

# ── Distributed rate limiting ────────────────────────────────────────
# Required in production for contact, intake, reviews, and Places lookup.
# Local development and tests use the bounded in-memory fallback when unset.
# Direct Upstash credentials (Vercel Marketplace's KV_REST_API_* equivalents
# are also supported and are injected automatically when the store is linked).
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── Unsplash — stock photos (optional) ──────────────────────────────
# Register at https://unsplash.com/developers → New Application
# Demo limit: 50 req/hr | Production: 5,000 req/hr
UNSPLASH_ACCESS_KEY="your_unsplash_access_key"
UNSPLASH_SECRET_KEY="your_unsplash_secret_key"

# ── Giscus comments (optional) ──────────────────────────────────────
# Get from https://giscus.app after enabling GitHub Discussions
NEXT_PUBLIC_GISCUS_REPO="owner/repo"
NEXT_PUBLIC_GISCUS_REPO_ID="R_kgDO..."
NEXT_PUBLIC_GISCUS_CATEGORY="General"
NEXT_PUBLIC_GISCUS_CATEGORY_ID="DIC_kwDO..."

# ── Blog subscription (optional) ────────────────────────────────────
NEXT_PUBLIC_BLOG_SUBSCRIBE_URL="https://your-provider-endpoint"

# ── Omni-Gridder admin demo (/admin/omni-gridder) ───────────────────
# og-server Cloud Run service URL + tenant API key
OG_SERVER_URL="https://og-server-xxxxx.a.run.app"
OG_SERVER_API_KEY="og_..."
# GCS bucket used to stage demo job inputs/outputs (input.nc, output.nc, plot.png)
OG_GCS_STAGING_BUCKET="esmai-dev-esmai-objects"
# Comma-separated allowlist of gs:// input URIs the demo may submit — the
# client can only pick from this list, never supply an arbitrary URI.
# First entry is the default. Falls back to a single known-good GFS field if unset.
OG_DEMO_INPUT_URIS="gs://esmai-dev-esmai-objects/demo/hgt500_2026070706_f006.nc"
# Workload Identity Federation — mints Google-signed tokens to invoke
# og-server (and, best-effort, to trigger the og-worker Cloud Run Job) with
# no long-lived service-account key. See src/lib/omni-gridder-auth.ts.
GCP_PROJECT_NUMBER="123456789012"
GCP_WORKLOAD_IDENTITY_POOL_ID="your-pool-id"
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID="your-provider-id"
GCP_SERVICE_ACCOUNT_EMAIL="omni-gridder-website-wif@esmai-dev.iam.gserviceaccount.com"
# Cloud Run Admin API target for the worker-auto-trigger (best-effort; the
# WIF service account may not yet hold IAM to run this Job — see
# triggerWorkerRun() in src/lib/omni-gridder-client.ts). Unset
# OG_WORKER_GCP_PROJECT_ID disables the trigger attempt entirely.
OG_WORKER_GCP_PROJECT_ID="esmai-dev"
OG_WORKER_GCP_REGION="us-central1"
OG_WORKER_JOB_NAME="og-worker"
# Set to "false" to disable the worker-auto-trigger attempt without a code change.
OG_ENABLE_WORKER_TRIGGER="true"

# Signing key for admin session cookies (32-byte hex). Falls back to a key
# derived from ADMIN_PASSPHRASE when unset; set it explicitly in production.
ADMIN_SESSION_SECRET=

# AES-256-GCM key for encrypting stored OAuth refresh tokens (32 bytes,
# hex or base64). Falls back to a NEXTAUTH_SECRET-derived key when unset.
TOKEN_ENCRYPTION_KEY=
